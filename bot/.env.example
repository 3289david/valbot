# Copy to .env and fill in. Never commit .env.

# Bot token and application ID (Discord Developer Portal -> your application)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: register commands only in one server while testing (instant). Leave empty for global commands.
DEV_GUILD_ID=

# HenrikDev Valorant API key (https://docs.henrikdev.xyz)
HENRIK_API_KEY=
# Requests per minute the bot allows itself. Set this to your key's limit.
HENRIK_REQUESTS_PER_MINUTE=25

# Shared data folder. Must be the SAME folder the website uses (website/data).
DATA_DIR=../website/data

# Public URL of the website, used for "Open dashboard" buttons. Leave empty to hide them.
DASHBOARD_URL=

# How often to refresh each linked account (minutes)
SYNC_ACTIVE_MINUTES=10
SYNC_IDLE_MINUTES=60
