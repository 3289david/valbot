# Copy this file to .env and fill in real values. Never commit .env.

# Port the website listens on
PORT=3000

# Public URL of this website (no trailing slash). Must match the redirect you add in the Discord Developer Portal.
PUBLIC_URL=http://localhost:3000

# Discord application (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot token of the same application. Used server-side only to read the bot's servers, channels and roles.
DISCORD_BOT_TOKEN=

# HenrikDev Valorant API key (https://docs.henrikdev.xyz). Server-side only.
HENRIK_API_KEY=

# Long random string used to sign login sessions
SESSION_SECRET=
